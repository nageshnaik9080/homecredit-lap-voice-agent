# ─────────────────────────────────────────────
# Home Credit LAP AI Voice Agent — Environment
# ─────────────────────────────────────────────

# Backend port (default 4000)
PORT=4000

# Frontend dev port (default 5173 via Vite)
VITE_API_BASE_URL=http://localhost:4000

# ── Retell AI (optional – leave blank to use mock mode) ──
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=

# ── Demo / Mock mode ──
# Set to "true" to run fully without any external API key
MOCK_MODE=true

# ── Company / Agent defaults ──
COMPANY_NAME=Home Credit
AGENT_NAME=Priya
AGENT_GENDER=female
LANGUAGE_TO_SPEAK=English
